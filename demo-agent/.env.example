# --- demo-agent (the simulated AI crawler) ---

RESOURCE_URL=http://localhost:3402/premium/market-report
FACILITATOR_URL=http://localhost:8402

# Identity this agent presents to the facilitator. In production this would be
# an authenticated agent credential; here it is just a string the ledger groups by.
AGENT_ID=agent-perplexity-bot

# Must match FACILITATOR_HMAC_SECRET. The agent signs its payment commitment
# with the same shared secret the facilitator verifies against — a demo
# simplification standing in for the agent's own keypair.
X402_HMAC_SECRET=dev-only-shared-secret-change-me
