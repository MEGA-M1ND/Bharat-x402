# --- resource-server (publisher side) ---
# Copy to .env and adjust. Nothing in this file is a secret — the resource
# server never signs anything itself. It gates content and forwards proof to
# the facilitator, which is the only service that holds the shared HMAC
# secret. See docs/architecture.md.

PORT=3402

# Where our INR facilitator lives. In stock x402 this would point at
# https://x402.org/facilitator (USDC on Base). Pointing it here is the whole idea.
FACILITATOR_URL=http://localhost:8402

# The publisher's settlement identity. For USDC this is an EVM address; for us
# it is the merchant account the facilitator credits.
PAY_TO=acc_BharatNewsNetwork

# Price per fetch, in rupees. Accepts "₹5.00", "Rs. 5", "5", or 5.
#
# Try 0.50 to see the point of the project: at that price every individual
# charge falls under the Razorpay Payment Links ₹1.00 minimum, so per-request
# settlement cannot collect the revenue at all and batching is the only way it
# exists.
#
# `rupeesToPaise` accepts "5", "5.00", "Rs. 5" and "₹5.00" alike, so the form
# here only affects display — but it affects it everywhere, because this exact
# string is what the 402 body and the resource listing show. Left bare it
# renders as "5.00" next to the code default's "₹0.50", which looks like a bug
# in the publisher rather than a difference in two env lines.
RESOURCE_PRICE=₹5.00

# A second resource at a price that itself sits under Razorpay's ₹1.00
# minimum — /premium/api-call. This is the route that gives the console's
# economics card something real to show: without it, every charge clears the
# gateway floor and "revenue uncollectable per-request" is always zero.
RESOURCE_PRICE_MICRO=₹0.50

# CAIP-style network id for our scheme. `Network` in @x402/core is typed as
# `${string}:${string}`, so a non-blockchain namespace is legal.
X402_NETWORK=razorpay:inr-test
