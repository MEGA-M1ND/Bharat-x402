# --- resource-server (publisher side) ---
# Copy to .env and adjust. No secrets belong in this file beyond the shared
# demo HMAC secret, which exists only because this MVP substitutes HMAC for the
# asymmetric signatures the real x402 spec uses. See docs/architecture.md.

PORT=3402

# Where our INR facilitator lives. In stock x402 this would point at
# https://x402.org/facilitator (USDC on Base). Pointing it here is the whole idea.
FACILITATOR_URL=http://localhost:8402

# The publisher's settlement identity. For USDC this is an EVM address; for us
# it is the merchant account the facilitator credits.
PAY_TO=acc_BharatNewsNetwork

# CAIP-style network id for our scheme. `Network` in @x402/core is typed as
# `${string}:${string}`, so a non-blockchain namespace is legal.
X402_NETWORK=razorpay:inr-test

# Shared secret used to HMAC-sign payment offers/commitments in this demo.
# Must match FACILITATOR_HMAC_SECRET in facilitator/.env.
X402_HMAC_SECRET=dev-only-shared-secret-change-me
