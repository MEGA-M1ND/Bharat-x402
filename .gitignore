# Secrets — never commit real Razorpay keys, even test-mode ones.
.env
.env.local
*.env
!.env.example

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Local ledger database (regenerated by the demo)
*.db
*.db-journal
*.sqlite3
data/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

.vercel
.env*

# Agent signing keys. The private half of an Ed25519 keypair is the one thing
# in this project that must exist in exactly one place — committing it would
# turn the keypair back into the shared secret it was built to replace.
.keys/
*.key

# Hypothesis's example database and constant cache. Machine-local state that
# speeds up repeat runs; committing it would add churn to every diff and
# would not make anyone else's runs reproducible.
.hypothesis/
