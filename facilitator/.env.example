# --- facilitator (the custom INR settlement service) ---
# Copy to .env and fill in. USE RAZORPAY TEST-MODE KEYS ONLY.
# Test keys start with rzp_test_. A key starting with rzp_live_ moves real
# money; main.py refuses to start if it sees one.

PORT=8402

# Razorpay test-mode credentials — https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Leave blank to run in MOCK_RAZORPAY mode (no network calls, fake link ids).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# When true (or when the keys above are blank) the facilitator fabricates
# plausible Razorpay responses instead of calling the API. Lets the whole demo
# run offline; set to false once you have test keys.
MOCK_RAZORPAY=true

# Shared secret for HMAC-signing offers and commitments in this demo.
# Must match X402_HMAC_SECRET in resource-server/.env and demo-agent/.env.
# Production would use asymmetric signatures per the x402 spec.
FACILITATOR_HMAC_SECRET=dev-only-shared-secret-change-me

# Settlement mode:
#   deferred    — record each ₹5 request as a commitment, settle in one batch later (default)
#   per_request — create a Razorpay Payment Link on every single request
# Deferred is the point of the project: Razorpay's per-transaction fee makes
# per-request settlement of a ₹5 charge uneconomic.
SETTLEMENT_MODE=deferred

# SQLite ledger location. Leave blank to use facilitator/data/ledger.db, which
# is where the reporting script looks.
#
# Set an absolute path if you override it. A relative path here is resolved
# against the working directory, so the ledger would move depending on where
# you launched the service from — and `uvicorn --app-dir facilitator` from the
# repo root launches from somewhere different than `cd facilitator` does.
LEDGER_DB_PATH=

# Set this (a postgres:// or postgresql:// URL) to use Postgres instead of
# SQLite — takes priority over LEDGER_DB_PATH when both are set. Apply
# facilitator/migrations/001_init.sql once, by hand, in your database's SQL
# editor before pointing this at it; the facilitator does not create the
# Postgres schema itself on startup (see the Ledger docstring for why).
#
# For Supabase, use the connection-pooler URL (port 6543), not the direct
# connection — psycopg's automatic query preparation is incompatible with
# the pooler's transaction mode and db.py already disables it accordingly,
# but the pooler is still the one meant for serverless-style connections.
LEDGER_DSN=

# Bootstrap the Postgres schema automatically on startup instead of applying
# the migration by hand. Only meant for a throwaway database that starts
# genuinely empty — CI's postgres:16 service container sets this; a real
# deployment should not.
LEDGER_AUTO_MIGRATE=false

# Max connections this process holds open in the Postgres pool. Keep small:
# a connection pooler's own client limit is shared across every concurrent
# instance of this service.
PG_POOL_MAX=3

# CAIP-style network id this facilitator advertises on /supported.
X402_NETWORK=razorpay:inr-test

# How long an offer stays valid, in seconds.
OFFER_TTL_SECONDS=300

# Refuse to quote more than this per request. A guard against a misconfigured
# resource server asking ₹10,00,000 for one API call.
MAX_OFFER_PAISE=100000

# --- settlement cost model -------------------------------------------------
# Used by /settle-batch to report what settlement actually costs. Defaults
# reflect Razorpay's publicly listed standard pricing; real merchant rates are
# negotiated, so plug in your own.

# Percentage fee in basis points. 200 = 2.00%.
FEE_PERCENT_BPS=200

# Flat per-transaction component, in paise. This is the part that batching
# genuinely eliminates — a percentage fee is neutral to batching.
FEE_FIXED_PAISE=0

# Tax on the fee itself. 1800 = 18% GST.
FEE_GST_BPS=1800

# Smallest amount the gateway will accept. Razorpay's documented floor is ₹1.00.
# This is the constraint that makes per-request settlement of sub-rupee agent
# traffic impossible, and deferred batching necessary.
RAZORPAY_MIN_CHARGE_PAISE=100

# --- agent identity --------------------------------------------------------
# Whether an agent with no registered Ed25519 key may still pay with a
# shared-secret HMAC proof. True keeps pre-keypair clients working while keys
# roll out; every such verification is logged as a downgrade. Set false to
# require POST /agents/register before an agent can pay.
#
# Note this does NOT weaken agents that have registered: once a key is on
# file, an HMAC proof from that agent is refused regardless of this setting.
ALLOW_HMAC_FALLBACK=true

# --- webhooks --------------------------------------------------------------
# Razorpay's webhook signing secret, from Dashboard > Settings > Webhooks.
# Leave blank and POST /webhooks/razorpay refuses every delivery with a 503 --
# it fails closed rather than accepting unauthenticated writes to the ledger.
#
# Point Razorpay at:  https://<your-host>/api/facilitator/webhooks/razorpay
# Subscribe to:       payment_link.paid, payment_link.expired,
#                     payment_link.cancelled
RAZORPAY_WEBHOOK_SECRET=

# --- spending controls -----------------------------------------------------
# MAX_OFFER_PAISE above caps a *single* quote. These cap what an agent can do
# with many of them, which is the difference between a transaction-size limit
# and an actual spending limit.

# Most an agent may commit in one settlement date, in paise. 50000 = ₹500.
# Set 0 for no cap. Enforced inside the INSERT that books a commitment, so it
# holds against concurrent settlements rather than only against polite ones.
AGENT_DAILY_CAP_PAISE=50000

# Most quotes one agent may request per minute. An offer is a cheap write that
# costs the facilitator a row and the agent nothing, so without this, flooding
# POST /offer is free. Set 0 for no limit.
AGENT_OFFER_RATE_PER_MINUTE=60

# Comma-separated agent ids refused outright — the operator's stop button for
# one misbehaving agent.
#
# This is config rather than an admin endpoint on purpose: the service has no
# authentication, so a POST /agents/{id}/freeze would let any caller disable
# any agent, turning a safety control into a denial-of-service primitive.
FROZEN_AGENTS=

# Global off switch. false refuses every agent, for draining the service
# before maintenance.
ACCEPT_PAYMENTS=true
